# PostgreSQL
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://localhost:5432/helpdeskdb
DB_USER=helpdesk_user
DB_PASSWORD=change_me

# JWT secret (REQUIRED - generate with: openssl rand -base64 48)
